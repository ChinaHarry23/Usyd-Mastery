# ── Third-party course material ──────────────────────────────────
# Lecture slides, tutorial solutions, workshop notebooks and datasets are
# OTHER PEOPLE'S COPYRIGHTED WORK. They are ignored so that a `git add .`
# can never publish them. The engine ships no course content of its own;
# see README.md.
*/chapters/*/materials/*
*/chapters/*/Materials/*
!*/chapters/*/materials/.gitkeep
!*/chapters/*/Materials/.gitkeep
content/*/chapters/*/materials/*

# Generator test scratch
.gen-a-*/
.gen-b-*/
