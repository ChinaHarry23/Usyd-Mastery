{
  "name": "usyd-mastery",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive study platform for University of Sydney CS courses",
  "scripts": {
    "test": "node tests/test-pure-functions.js && node tests/test-dom-integration.js && node tests/test-interactive.js && node tests/test-hub-structure.js && node tests/test-site-reset.js && node tests/test-generator.js",
    "test:unit": "node tests/test-pure-functions.js",
    "test:dom": "node tests/test-dom-integration.js",
    "lint": "eslint \"shared/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"sw.js\" \"**/chapter*-*.js\"",
    "lint:fix": "eslint --fix \"shared/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"sw.js\" \"**/chapter*-*.js\"",
    "format": "prettier --write \"shared/**/*.{js,css}\" \"scripts/**/*.js\" \"tests/**/*.js\" \"*.js\" \"**/chapter*-*.js\"",
    "format:check": "prettier --check \"shared/**/*.{js,css}\" \"scripts/**/*.js\" \"tests/**/*.js\" \"*.js\" \"**/chapter*-*.js\"",
    "validate": "node scripts/validate.js && node scripts/validate-manifest.js && node scripts/verify-graph-data.js --check && node scripts/audit-denominators.js --check",
    "validate:sync": "bash scripts/sync-shared.sh --check",
    "ci": "npm run lint && npm run validate && npm test && npm run validate:sync",
    "test:interactive": "node tests/test-interactive.js",
    "audit:denominators": "node scripts/audit-denominators.js",
    "audit:check": "node scripts/audit-denominators.js --check",
    "test:structure": "node tests/test-hub-structure.js",
    "verify:graphs": "node scripts/verify-graph-data.js",
    "test:reset": "node tests/test-site-reset.js",
    "verify:pack": "node scripts/verify-pack.js content/demo",
    "build:demo": "node scripts/build-hub.js content/demo --out demo",
    "templates": "node scripts/extract-templates.js",
    "test:generator": "node tests/test-generator.js"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "jsdom": "^27.0.1",
    "prettier": "^3.8.1"
  }
}
